@model IEnumerable<ECommerceMVC.ViewModels.CartItem>
@{
	ViewData["Title"] = "Giỏ hàng";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
	<h1 class="text-center text-white display-6">Giỏ Hàng</h1>
	<ol class="breadcrumb justify-content-center mb-0">
		<li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
		<li class="breadcrumb-item active text-white">Giỏ hàng</li>
	</ol>
</div>
<!-- Single Page Header End -->
<!-- Cart Page Start -->
<div class="container-fluid py-5">
	<div class="container py-5">
		@if (TempData["CartMessage"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				<i class="fas fa-check-circle me-2"></i>@TempData["CartMessage"]
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		}

		@if (Model.Any())
		{
			<div class="table-responsive">
				<table class="table">
					<thead>
						<tr>
							<th scope="col">Hình ảnh</th>
							<th scope="col">Tên sản phẩm</th>
							<th scope="col">Đơn giá</th>
							<th scope="col">Số lượng</th>
							<th scope="col">Thành tiền</th>
							<th scope="col">Thao tác</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr data-product-id="@item.MaHh" data-price="@item.DonGia">
								<th scope="row">
									<div class="d-flex align-items-center">
										<img src="~/Hinh/HangHoa/@item.Hinh"
											 class="img-fluid me-3 rounded-circle"
											 style="width: 80px; height: 80px; object-fit: cover;"
											 alt="@item.TenHH">
									</div>
								</th>
								<td>
									<p class="mb-0 mt-4">
										<a asp-action="Detail" asp-controller="HangHoa" asp-route-id="@item.MaHh" class="text-dark">
											<strong>@item.TenHH</strong>
										</a>
									</p>
								</td>
								<td>
									<p class="mb-0 mt-4 text-primary fw-bold">@item.DonGia.ToString("N0")₫</p>
								</td>
								<td>
									<div class="input-group quantity mt-3" style="width: 130px;">
										<button class="btn btn-sm btn-minus rounded-circle bg-light border" type="button">
											<i class="fa fa-minus"></i>
										</button>
										<input type="number"
											   class="form-control form-control-sm text-center border quantity-input"
											   value="@item.SoLuong"
											   min="1"
											   max="99">
										<button class="btn btn-sm btn-plus rounded-circle bg-light border" type="button">
											<i class="fa fa-plus"></i>
										</button>
									</div>
								</td>
								<td>
									<p class="mb-0 mt-4 text-danger fw-bold item-total">@item.ThanhTien.ToString("N0")₫</p>
								</td>
								<td>
									<a asp-action="RemoveCart"
									   asp-controller="Cart"
									   asp-route-id="@item.MaHh"
									   class="btn btn-md rounded-circle bg-light border mt-3"
									   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
										<i class="fa fa-times text-danger"></i>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<div class="row g-4 justify-content-end mt-4">
				<div class="col-sm-8 col-md-7 col-lg-6 col-xl-4">
					<div class="bg-light rounded p-4">
						<h4 class="mb-4">Tổng giỏ hàng</h4>

						<div class="d-flex justify-content-between mb-3">
							<h5 class="mb-0">Tạm tính:</h5>
							<p class="mb-0 fw-bold text-primary" id="cartSubtotal">@Model.Sum(p => p.ThanhTien).ToString("N0")₫</p>
						</div>

						<div class="d-flex justify-content-between mb-3">
							<h5 class="mb-0">Phí vận chuyển:</h5>
							<p class="mb-0">Miễn phí</p>
						</div>

						<hr class="my-3">

						<div class="d-flex justify-content-between mb-4">
							<h4 class="mb-0">Tổng cộng:</h4>
							<h4 class="mb-0 text-danger" id="cartTotal">@Model.Sum(p => p.ThanhTien).ToString("N0")₫</h4>
						</div>

						<a class="btn btn-primary rounded-pill w-100 py-3 text-uppercase"
						   asp-action="Checkout"
						   asp-controller="Cart">
							<i class="fas fa-shopping-cart me-2"></i>Tiến hành thanh toán
						</a>

						<a class="btn btn-outline-secondary rounded-pill w-100 py-3 mt-2"
						   asp-action="Index"
						   asp-controller="HangHoa">
							<i class="fas fa-arrow-left me-2"></i>Tiếp tục mua hàng
						</a>
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="text-center py-5">
				<i class="fas fa-shopping-cart fa-5x text-muted mb-4"></i>
				<h3>Giỏ hàng của bạn đang trống</h3>
				<p class="text-muted">Hãy thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm</p>
				<a asp-action="Index" asp-controller="HangHoa" class="btn btn-primary rounded-pill px-5 py-3 mt-3">
					<i class="fas fa-shopping-bag me-2"></i>Mua sắm ngay
				</a>
			</div>
		}
	</div>
</div>
<!-- Cart Page End -->
@section Scripts {
	<script>
		$(document).ready(function () {
			console.log('✅ Cart page loaded');

			// ============ XỬ LÝ TĂNG/GIẢM SỐ LƯỢNG ============
			$('.btn-plus').on('click', function(e) {
				e.preventDefault(); // ✅ Ngăn form submit
				e.stopPropagation(); // ✅ Ngăn event bubble

				var $input = $(this).closest('.quantity').find('.quantity-input');
				var currentVal = parseInt($input.val()) || 1;
				var maxVal = parseInt($input.attr('max')) || 99;

				if (currentVal < maxVal) {
					$input.val(currentVal + 1).trigger('change');
				}
			});

			$('.btn-minus').on('click', function(e) {
				e.preventDefault(); // ✅ Ngăn form submit
				e.stopPropagation(); // ✅ Ngăn event bubble

				var $input = $(this).closest('.quantity').find('.quantity-input');
				var currentVal = parseInt($input.val()) || 1;
				var minVal = parseInt($input.attr('min')) || 1;

				if (currentVal > minVal) {
					$input.val(currentVal - 1).trigger('change');
				}
			});

			// ============ XỬ LÝ THAY ĐỔI SỐ LƯỢNG ============
			$('.quantity-input').on('change', function() {
				var $row = $(this).closest('tr');
				var productId = $row.data('product-id');
				var newQuantity = parseInt($(this).val()) || 1;
				var price = parseFloat($row.data('price'));

				// Validate
				var minVal = parseInt($(this).attr('min')) || 1;
				var maxVal = parseInt($(this).attr('max')) || 99;

				if (newQuantity < minVal) {
					newQuantity = minVal;
					$(this).val(newQuantity);
				} else if (newQuantity > maxVal) {
					newQuantity = maxVal;
					$(this).val(newQuantity);
				}

				// Cập nhật thành tiền của sản phẩm
				var itemTotal = price * newQuantity;
				$row.find('.item-total').text(formatCurrency(itemTotal));

				// Cập nhật tổng giỏ hàng
				updateCartTotal();

				// ✅ GỬI REQUEST CẬP NHẬT SERVER
				$.ajax({
					url: '/Cart/UpdateQuantity',
					type: 'POST',
					data: {
						id: productId,
						quantity: newQuantity
					},
					success: function(response) {
						console.log('✅ Quantity updated on server');
						// Reload page để cập nhật session và xóa voucher
						location.reload();
					},
					error: function(xhr, status, error) {
						console.error('❌ Update failed:', error);
						alert('Có lỗi xảy ra khi cập nhật số lượng!');
						location.reload();
					}
				});
			});

			// ============ CẬP NHẬT TỔNG TIỀN ============
			function updateCartTotal() {
				var total = 0;

				$('tr[data-product-id]').each(function() {
					var quantity = parseInt($(this).find('.quantity-input').val()) || 1;
					var price = parseFloat($(this).data('price'));
					total += price * quantity;
				});

				$('#cartSubtotal').text(formatCurrency(total));
				$('#cartTotal').text(formatCurrency(total));
			}

			// ============ FORMAT CURRENCY ============
			function formatCurrency(amount) {
				return new Intl.NumberFormat('vi-VN').format(amount) + '₫';
			}

			// ============ XỬ LÝ NHẬP TRỰC TIẾP ============
			$('.quantity-input').on('keypress', function(e) {
				// Chỉ cho phép số
				if (e.which < 48 || e.which > 57) {
					e.preventDefault();
				}
			});

			// ============ VALIDATE KHI BLUR ============
			$('.quantity-input').on('blur', function() {
				var val = parseInt($(this).val());
				var minVal = parseInt($(this).attr('min')) || 1;
				var maxVal = parseInt($(this).attr('max')) || 99;

				if (isNaN(val) || val < minVal) {
					$(this).val(minVal).trigger('change');
				} else if (val > maxVal) {
					$(this).val(maxVal).trigger('change');
				}
			});
		});
	</script>

	<style>
		.quantity-input {
			width: 50px;
			padding: 0.25rem 0.5rem;
			font-size: 14px;
		}

			.quantity-input::-webkit-outer-spin-button,
			.quantity-input::-webkit-inner-spin-button {
				-webkit-appearance: none;
				margin: 0;
			}

			.quantity-input[type=number] {
				-moz-appearance: textfield;
			}

		.btn-plus, .btn-minus {
			width: 32px;
			height: 32px;
			padding: 0;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.alert {
			position: relative;
			animation: slideDown 0.3s ease-out;
		}

		@@keyframes slideDown {
			from

		{
			opacity: 0;
			transform: translateY(-20px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}

		}</style>
}